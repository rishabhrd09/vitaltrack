{
  "name": "carekosh-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:demo": "vite --mode demo --host 127.0.0.1",
    "dev:api": "vite --mode api --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "tsc --noEmit && vite build && node scripts/verify-build.mjs production",
    "build:demo": "tsc --noEmit && vite build --mode demo",
    "build:staging": "tsc --noEmit && vite build --mode staging && node scripts/verify-build.mjs staging",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:hosting": "node scripts/verify-hosting.mjs",
    "test:build-guards": "node scripts/verify-build-guards.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "preview:cloudflare": "wrangler dev --local --port 8787",
    "deploy:staging": "npm run check && npm run build:staging && wrangler deploy --env staging",
    "deploy:production": "npm run check && npm run build && wrangler deploy --env production",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:build-guards"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@tanstack/react-query": "^5.104.5",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "undici": "^7.30.1"
  }
}
