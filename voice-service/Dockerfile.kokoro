FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OMP_NUM_THREADS=2
WORKDIR /service
COPY requirements.kokoro.txt .
RUN pip install --no-cache-dir -r requirements.kokoro.txt && useradd --uid 10001 --create-home speech
COPY app.py kokoro_app.py ./
USER speech
EXPOSE 8080
CMD ["uvicorn", "kokoro_app:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1", "--no-access-log"]
