# VitalTrack Backend - Environment Variables
# Copy this file to .env and update values for your environment

# =============================================================================
# APPLICATION
# =============================================================================
APP_NAME=VitalTrack API
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development  # development, staging, production

# =============================================================================
# SERVER
# =============================================================================
HOST=0.0.0.0
PORT=8000

# =============================================================================
# DATABASE
# =============================================================================
# PostgreSQL connection URL
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vitaltrack

# Connection pool settings
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# =============================================================================
# SECURITY
# =============================================================================
# IMPORTANT: Change this in production!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE-THIS-IN-PRODUCTION-MIN-32-CHARS-LONG-RANDOM-STRING

# JWT Settings
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# =============================================================================
# CORS
# =============================================================================
# Comma-separated list of allowed origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:8081","http://localhost:19006","exp://localhost:8081"]

# =============================================================================
# EMAIL / AUTH LINKS
# =============================================================================
# Blank MAIL_PASSWORD disables email delivery in local development.
# MAIL_SERVER/MAIL_PORT/MAIL_STARTTLS are legacy SMTP-era keys and are not used
# by the current Brevo HTTP send path.
MAIL_PASSWORD=
MAIL_FROM=noreply@carekosh.com
FRONTEND_URL=http://localhost:8000/api/v1/auth
REQUIRE_EMAIL_VERIFICATION=false

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# =============================================================================
# OPTIONAL READ-ONLY VOICE ASSISTANT — server-side only; NEVER EXPO_PUBLIC_ keys
# =============================================================================
# Optional text-only Groq pilot: enable AI_ENABLED and set GROQ_API_KEY on
# the staging backend after deploying the /ai routes. Mark data controls
# reviewed only after checking the account's Groq settings. Keep audio off.
# Keep the conservative request and budget limits below for the initial pilot.
AI_ENABLED=false
AI_TRANSCRIBE_ENABLED=false
AI_DATA_CONTROLS_REVIEWED=false
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3
GROQ_INTENT_MODEL=openai/gpt-oss-20b
AI_TIMEOUT_SECONDS=25
AI_USER_DAILY_REQUESTS=50
AI_GLOBAL_DAILY_REQUESTS=500
AI_GLOBAL_CONCURRENCY=4
AI_USER_DAILY_BUDGET_MICROUSD=100000
AI_GLOBAL_DAILY_BUDGET_MICROUSD=1000000
AI_INTERPRET_RESERVE_MICROUSD=5000
AI_TRANSCRIBE_RESERVE_MICROUSD=1000
AI_SPEAK_RESERVE_MICROUSD=1000
# Enable only after Alba rights review and a separate speech service deployment.
AI_SPEECH_ENABLED=false
AI_ALBA_RIGHTS_APPROVED=false
PIPER_SERVICE_URL=
PIPER_SERVICE_TOKEN=

# Option 1: offline Android listening/device speech need NO provider keys.
# Optional Sarvam pilot: private backend-only key, separate reviewed controls.
SARVAM_API_KEY=
AI_SARVAM_ENABLED=false
AI_SARVAM_DATA_CONTROLS_REVIEWED=false
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_SPEAKER=shubh
AI_SARVAM_TRANSCRIBE_RESERVE_MICROUSD=5000
AI_SARVAM_SPEAK_RESERVE_MICROUSD=20000
# Optional hosted Kokoro audition; no automatic fallback from device speech.
AI_KOKORO_ENABLED=false
AI_KOKORO_RIGHTS_APPROVED=false
KOKORO_SERVICE_URL=
KOKORO_SERVICE_TOKEN=
